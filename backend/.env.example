# CyberTrust Decision Engine — Environment Variables
# Copy this file to .env and fill in your values

# ── JWT (REQUIRED — change this in production) ────────────────────────────────
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, works out of the box):
DATABASE_URL=sqlite:///./ctde.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ctde

# ── AI Explanations (optional — rule-based fallback if not set) ───────────────
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# ── Threat Intelligence APIs (optional — graceful fallback if not set) ─────────
# Get free key at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# Get free key at: https://console.cloud.google.com/ (Safe Browsing API)
GOOGLE_SAFE_BROWSING_API_KEY=

# Get free key at: https://urlscan.io/user/signup
URLSCAN_API_KEY=

# Get free key at: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
HTTP_TIMEOUT=15.0
HTTP_MAX_REDIRECTS=10
REPORTS_DIR=reports
