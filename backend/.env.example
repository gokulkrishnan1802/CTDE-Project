# CyberTrust Decision Engine — Environment Variables
# Copy this file to .env and fill in your values.

# JWT (change this secret in production)
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand

# Database
# SQLite default:
DATABASE_URL=sqlite:///./ctde.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ctde

# AI explanations (optional; rule-based fallback is used without a key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# Optional threat intelligence APIs
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=

# App
DEBUG=false
HTTP_TIMEOUT=15.0
HTTP_MAX_REDIRECTS=10
REPORTS_DIR=reports

# Google Sign-In
GOOGLE_CLIENT_ID=219044358631-f3hlcjf3ihsii9vs01qm99ai2jn8u7ot.apps.googleusercontent.com